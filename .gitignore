node_modules/
out/
.env
.DS_Store
*.log

# Editor / IDE
.idea/
.vscode/

# Build artifacts
web/dist/
*.tsbuildinfo

# Local caches and state. Both are regenerable and must never be committed:
# snapshots are per-machine diff baselines, and the poster cache is ~11 MB of
# binary that the pipeline re-downloads on demand.
data/snapshots/*
!data/snapshots/.gitkeep
data/posters/*
!data/posters/.gitkeep

# The internal first-party trending export. Never committed and deliberately
# given NO seeded fallback: a stale trending signal rendered as this week's is
# worse than no signal at all, so each run pulls a fresh copy or goes without.
data/fandom_trending.csv
data/wiki-articles.json

# Backtest pageview history — regenerable, delete to refetch.
data/backtest-series.json
