{
  "name": "tv-movies-domain-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Upcoming TV & film release radar for the Fandom TV/Movies domain team.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "scan": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "scan:publish": "node --env-file-if-exists=.env --import tsx src/index.ts --publish --no-render",
    "trailer": "node --env-file-if-exists=.env --import tsx scripts/trailer.ts",
    "serve": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "dashboard": "npm run scan && npm run web:build && npm run serve",
    "backtest": "node --env-file-if-exists=.env --import tsx scripts/backtest.ts",
    "typecheck": "tsc --noEmit",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
