# Optional API credentials for the daily signal snapshots.
# Copy to .env and fill in. Both sources no-op cleanly when absent, so the
# pipeline still runs without them — it just records no reading for that source.

# YouTube Data API v3. Free, self-serve, no approval:
#   console.cloud.google.com -> enable "YouTube Data API v3" -> create API key
YOUTUBE_API_KEY=

# TMDB v3 Read Access Token (Bearer). TMDB account -> Settings -> API.
# NOTE: TMDB is free for NON-COMMERCIAL use with attribution. Clear commercial
# use with TMDB before this goes user-facing. See README "Signal sources".
TMDB_ACCESS_TOKEN=

# --- Snapshot storage (pandora/scriptlr) ------------------------------------
# Unset = the pipeline stays entirely local, exactly as before.
#
# Uploads exist ONLY on the on-prem deployment; the public multi-region one is
# read-only (its upload routes are not registered at all), hence two URLs.
# Register the app once before the first publish:
#   curl -X POST $SCRIPTLR_WRITE_URL/apps -d '{"appId":"tv-movies-radar"}'
SCRIPTLR_READ_URL=
SCRIPTLR_WRITE_URL=
SCRIPTLR_APP_ID=tv-movies-radar
SCRIPTLR_TOKEN=
