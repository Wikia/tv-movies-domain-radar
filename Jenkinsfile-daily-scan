// Daily release-radar scan.
//
// Fetches the calendar, records one reading per signal source, scores them and
// publishes the result to scriptlr. The dashboard reads what this job writes, so
// if this stops running the site quietly serves yesterday's answer for ever.
//
// Snapshots are write-once: the deployed bucket rejects replacing an object, so a
// second run on the same date leaves the published copy alone and says so. The
// day-over-day diff is anchored to the previous date, so a re-run still reports
// "what changed since yesterday" rather than "nothing changed".

pipeline {
    agent { label 'linux' }

    triggers {
        // 'H' spreads start times across the hour to avoid load spikes; the
        // exact minute is stable per job. 05:00 leaves Wikipedia's ~4-day
        // pageview lag and the US news cycle behind us before we read them.
        cron('H 5 * * *')
    }

    parameters {
        // Default TRUE because the scheduled build uses defaults: with this off,
        // the cron would scan every morning and upload nothing, which looks
        // healthy from the outside. Untick it for a dry run.
        booleanParam(
            name: 'PUBLISH',
            defaultValue: true,
            description: 'Upload snapshots to scriptlr. Untick for a dry run that scans but publishes nothing.'
        )
    }

    options {
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '60'))
        disableConcurrentBuilds()
    }

    stages {
        stage('Install') {
            steps {
                nodejs('v22 LATEST') {
                    // NOT --omit=dev. There are no runtime dependencies, but the
                    // pipeline is TypeScript executed through tsx, which is a
                    // devDependency — omitting them leaves nothing to run.
                    sh 'npm ci'
                }
            }
        }

        stage('Scan') {
            when { expression { !params.PUBLISH } }
            steps {
                runRadar('npm run scan')
            }
        }

        stage('Scan and publish') {
            when { expression { params.PUBLISH } }
            steps {
                runRadar('npm run scan:publish')
            }
        }
    }

    post {
        always {
            script {
                // The pipeline degrades rather than dying: a bad day at YouTube
                // costs that reading, not the calendar. So the exit code alone
                // under-reports, and run.json carries the real verdict.
                def report = null
                try {
                    if (fileExists('out/run.json')) {
                        report = readJSON(file: 'out/run.json')
                    }
                } catch (Exception noWorkspace) {
                    // Died before the agent was ready, so there is no workspace
                    // to read. Nothing to report but the failure itself.
                    echo "No workspace to read run.json from: ${noWorkspace.message}"
                }

                if (report == null) {
                    currentBuild.result = 'FAILURE'
                    currentBuild.description = 'no run.json — the scan died before it could report'
                } else {
                    if (report.status == 'failed') {
                        currentBuild.result = 'FAILURE'
                    } else if (report.status == 'degraded') {
                        // Shipped, but something is off. UNSTABLE rather than
                        // FAILURE: waking someone for a flat YouTube day trains
                        // them to ignore the alert.
                        currentBuild.result = 'UNSTABLE'
                    }
                    currentBuild.description = "${report.counts.titles ?: '?'} titles, " +
                        "${report.counts.rising ?: 0} rising, ${report.counts.confirmed ?: 0} confirmed"
                }

                try {
                    archiveArtifacts artifacts: 'out/run.json,out/radar.json', allowEmptyArchive: true
                } catch (Exception noWorkspace) {
                    echo "Nothing to archive: ${noWorkspace.message}"
                }
                notifyBuild(report)
            }
        }
    }
}

// The API keys arrive as one uploaded .env rather than a credential per key: the
// pipeline already reads .env via --env-file-if-exists, so adding a source later
// needs no Jenkins change.
//
// The credential is OPTIONAL on purpose. Four of the six sources need no keys —
// the calendar, Wikipedia, Google News and the Fandom export are all keyless — so
// a missing .env costs the YouTube and TMDB readings and nothing else.
//
// The file is removed straight after: the workspace is reused between builds, so
// a file of keys left in it would outlive the run that needed it.
def runRadar(String command) {
    def wroteEnv = false
    try {
        withCredentials([file(credentialsId: 'tv-movies-radar-env', variable: 'ENV_FILE')]) {
            sh 'cp "$ENV_FILE" .env && chmod 600 .env'
        }
        wroteEnv = true
    } catch (Exception missing) {
        echo 'No tv-movies-radar-env credential — YouTube and TMDB will be skipped.'
    }
    try {
        nodejs('v22 LATEST') {
            sh command
        }
    } finally {
        if (wroteEnv) {
            sh 'rm -f .env'
        }
    }
}

// Which service a step name refers to, in the words a person would use. Anything
// absent from this map is internal plumbing: diff, posters, publish, render.
def apiNames() {
    return [
        calendar : 'neutron-api (release calendar)',
        buzz     : 'Wikipedia pageviews',
        news     : 'Google News',
        youtube  : 'YouTube Data API',
        tmdb     : 'TMDB',
        trending : 'Fandom trending export',
    ]
}

// Up to two messages, in this order:
//
//   1. an ALERT, if any source hit an error — posted first and on its own, so it
//      is not buried inside a message that also says "complete"
//   2. the OUTCOME — green if the scan finished, red if it did not
//
// A source that is merely unconfigured (no key) is not an alert: it would fire
// every morning until someone adds the key, and a daily alarm nobody can action
// is one people learn to scroll past. Those are named in the outcome instead.
def notifyBuild(report) {
    def link = "<${env.BUILD_URL}|${env.JOB_NAME} #${env.BUILD_NUMBER}>"

    if (report == null) {
        slackPost('#FF0000', ":rotating_light: *Radar scan failed* ${link}\nIt died before it could write a report. <!here>")
        return
    }

    def apis = apiNames()

    // --- 1. the alert, posted first -----------------------------------------
    def brokenSources = report.steps.findAll {
        apis[it.name] && (it.status == 'failed' || it.status == 'degraded')
    }
    def brokenOther = report.steps.findAll { !apis[it.name] && it.status == 'failed' }

    if (brokenSources || brokenOther || report.warnings) {
        def alert = [":warning: *Radar sources need attention* ${link}"]
        brokenSources.each {
            def what = it.status == 'failed' ? 'pulled no data' : 'partial data'
            alert.add(":x: *${apis[it.name]}* — ${what}: ${it.detail}")
        }
        brokenOther.each {
            alert.add(":x: *${it.name}* failed — ${it.detail}")
        }
        report.warnings.each {
            alert.add(":warning: ${it}")
        }
        slackPost('#F0AD4E', alert.join('\n'))
    }

    // --- 2. the outcome -----------------------------------------------------
    if (currentBuild.currentResult == 'FAILURE') {
        def why = report.steps.findAll { it.status == 'failed' }.collect { "${it.name}: ${it.detail}" }
        def body = why ? why.join('\n') : 'See the console log.'
        slackPost('#FF0000', ":rotating_light: *Radar scan failed* ${link}\n${body}\n<!here>")
        return
    }

    def counts = report.counts
    def pulled = report.steps.findAll { apis[it.name] && it.status == 'ok' }.collect { apis[it.name] }
    def unconfigured = report.steps.findAll { apis[it.name] && it.status == 'skipped' }.collect { apis[it.name] }

    def done = [":white_check_mark: *Radar scan complete* ${link}"]
    done.add("${counts.titles ?: 0} titles · ${counts.rising ?: 0} rising · ${counts.confirmed ?: 0} confirmed by 2+ sources" + (report.published ? " · published ${report.today}" : ' · not published'))
    if (pulled) {
        done.add("Pulled: ${pulled.join(', ')}")
    }
    if (unconfigured) {
        done.add("_Not configured: ${unconfigured.join(', ')}_")
    }
    slackPost('#7AF371', done.join('\n'))
}

def slackPost(String colour, String message) {
    try {
        slackSend(channel: '#radar-test', color: colour, failOnError: true, message: message)
    } catch (Exception error) {
        // A notification problem must not fail a scan that worked.
        echo "Slack notification failed: ${error.message}"
    }
}
